# このファイルを .env にコピーして使う（.env は .gitignore 済み＝コミットされません）
#
#   cp .env.example .env
#   vi .env
#
# ローカル cron（scripts/install_cron.sh）は launchd 経由で動くため
# .zshrc などの環境変数を引き継がない。トークンはここに書く。

# --- Supercell 公式 API（マップローテーションの取得に使う）---
# https://developer.brawlstars.com/ で無料登録し、
# 「実行するマシンのグローバル IP」を許可したキーを発行して貼る。
# ⚠️ IP が変わると 403 になるのでキーを作り直すこと。
# ⚠️ IP が固定できない GitHub Actions では使えない。
BRAWLSTARS_API_TOKEN=

# --- Brawlify の Cloudflare を通すための Cookie（任意・短命）---
# ブラウザで https://brawlify.com を開いてチャレンジを通し、
# cf_clearance Cookie の値を持ってくる。数時間〜数日で失効する。
BRAWLIFY_COOKIE=

# --- 追加ヘッダが必要なとき（任意・JSON）---
# BRAWLIFY_EXTRA_HEADERS={"X-Foo":"bar"}
